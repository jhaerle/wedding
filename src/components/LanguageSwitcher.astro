---
import { getDictionary, pageUrl, switcherOptions, type Locale } from '../i18n';
interface Props { lang: Locale; slug?: string; }
const { lang, slug = '' } = Astro.props;
const t = getDictionary(lang);
---
<details class="lang" data-lang-switcher>
  <summary aria-label={t.nav.language}>
    <img src="/assets/brand/globe.svg" alt="" width="34" height="34" />
  </summary>
  <ul>
    {switcherOptions.map((o) => (
      <li>
        <a
          href={pageUrl(o.lang, slug)}
          lang={o.lang}
          hreflang={o.lang}
          aria-label={o.name}
          aria-current={o.lang === lang ? 'true' : undefined}
        >{o.short}</a>
      </li>
    ))}
  </ul>
</details>

<script>
  // Close the dropdown on outside click or Escape.
  document.querySelectorAll<HTMLDetailsElement>('[data-lang-switcher]').forEach((el) => {
    document.addEventListener('click', (e) => { if (!el.contains(e.target as Node)) el.open = false; });
    el.addEventListener('keydown', (e) => { if (e.key === 'Escape') { el.open = false; el.querySelector('summary')?.focus(); } });
  });
</script>

<style>
  .lang { position: relative; flex: none; }
  summary { list-style: none; cursor: pointer; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; }
  summary::-webkit-details-marker { display: none; }
  summary img { width: 2.125rem; height: auto; }
  summary:hover img { opacity: .7; }
  ul {
    list-style: none; margin: .5rem 0 0; padding: .25rem 0 .25rem 1.25rem;
    position: absolute; top: 100%; right: 0; min-width: 5.875rem; z-index: 20;
    background: rgb(1 75 113 / .15); border-left: 2px solid var(--ocean-blue);
    backdrop-filter: blur(6px);
  }
  a { display: block; text-decoration: none; color: var(--anthracite); line-height: 1.3; padding-right: 1.25rem; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  a[aria-current="true"] { font-weight: var(--weight-semibold); }
</style>
