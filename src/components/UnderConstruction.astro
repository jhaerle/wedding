---
// The "under construction" holding page (design: Figma "Page en construction").
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Website under construction</title>
  </head>
  <body>
    <div class="frame">
      <img class="logo" src="/assets/D_J_Logomark_Beige.svg" alt="D &amp; J monogram" />
      <div class="florals" aria-hidden="true">
        <img class="corner-tr" src="/assets/construction/Illu_Fleurs-04.svg" alt="" />
        <img class="corner-tr small" src="/assets/construction/Illu_Fleurs4.svg" alt="" />
        <img class="corner-bl" src="/assets/construction/Illu_Fleurs4.svg" alt="" />
        <img class="corner-bl small" src="/assets/construction/Illu_Fleurs-04.svg" alt="" />
      </div>
      <main class="content">
        <h1>Website under construction</h1>
        <p class="sub">Come back soon for more info</p>
      </main>
    </div>
  </body>
</html>

<style is:global>
  @font-face { font-family: "EB Garamond"; src: url("/assets/EBGaramond-Italic-VariableFont_wght.ttf") format("truetype"); font-weight: 400 700; font-style: italic; font-display: swap; }
  @font-face { font-family: "IM Fell English"; src: url("/assets/IMFellEnglish-Italic.ttf") format("truetype"); font-weight: 400; font-style: italic; font-display: swap; }
  :root { --navy: #014b71; --white: #ffffff; --muted: #80a5b8; }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body { background: var(--navy); overflow: hidden; position: relative; }
  .frame { position: relative; width: 100%; min-height: 100svh; display: flex; align-items: center; }
  .logo { position: absolute; top: max(44px, env(safe-area-inset-top, 0px) + 28px); left: clamp(24px, 5vw, 64px); width: 76px; height: auto; z-index: 3; }
  .florals { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .florals img { position: absolute; filter: invert(1); opacity: .14; }
  .corner-tr { top: -8%; right: -6%; width: min(42vw, 520px); }
  .corner-tr.small { top: 6%; right: 14%; width: min(16vw, 190px); opacity: .10; }
  .corner-bl { bottom: -10%; left: -7%; width: min(42vw, 520px); }
  .corner-bl.small { bottom: 10%; left: 15%; width: min(16vw, 190px); opacity: .10; }
  .content { position: relative; z-index: 2; max-width: 720px; padding: 0 clamp(28px, 8vw, 120px); }
  h1 { margin: 0; font-family: "IM Fell English", serif; font-style: italic; font-weight: 400; color: var(--white); font-size: clamp(28px, 4.6vw, 52px); line-height: 1.15; }
  p.sub { margin: 16px 0 0 2px; font-family: "EB Garamond", serif; font-style: italic; font-weight: 400; color: var(--muted); font-size: clamp(16px, 1.9vw, 24px); }
  @media (max-width: 640px) {
    .corner-tr { top: -8%; right: -18%; width: 78vw; }
    .corner-bl { bottom: -10%; left: -20%; width: 78vw; }
    .corner-tr.small, .corner-bl.small { display: none; }
    .logo { width: 58px; }
  }
</style>
