---
import '@fontsource/im-fell-great-primer/latin-400.css';
import '@fontsource/afacad-flux/latin-300.css';
import '../styles/global.css';
import { locales, type Locale } from '../i18n';

interface Props { title: string; lang: Locale; }
const { title, lang } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(en|fr|de|es)(?=\/|$)/, '');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {locales.map((l) => <link rel="alternate" hreflang={l} href={`/${l}${path}`} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
