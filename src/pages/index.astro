---
import Base from '../layouts/Base.astro';
import { pageUrl } from '../i18n';
import { pickerOptions, pickerDate } from '../i18n/picker';

// Decorative blooms. x/y = centre in the 1512×823 Figma frame, w = natural width (px), r = rotation.
const blooms = [
  { src: 'bloom-a', x: 1393, y: 149, w: 335, h: 400 },
  { src: 'bloom-b', x: 1450, y: 251, w: 204, h: 179 },
  { src: 'bloom-c', x: 62, y: 372, w: 392, h: 368, r: '177.97deg' },
  { src: 'bloom-d', x: 120, y: 326, w: 222, h: 197, r: '177.97deg' },
  { src: 'bloom-c', x: 1463, y: 497, w: 392, h: 368, r: '95.14deg' },
  { src: 'bloom-d', x: 1425, y: 433, w: 222, h: 197, r: '95.14deg' },
  { src: 'bloom-e', x: 120, y: 673, w: 330, h: 394, r: '-59.46deg', flip: true, bottom: true },
];
---
<Base title="Daniela & Julien" lang="en">
  <main class="stage" data-theme="ocean">
    <div class="blooms" aria-hidden="true">
      {blooms.map((b) => (
        <img
          class:list={['bloom', { bottom: b.bottom, flip: b.flip }]}
          src={`/assets/brand/${b.src}.svg`}
          alt=""
          width={b.w}
          height={b.h}
          style={`--x:${b.x};--y:${b.y};--w:${b.w};--r:${b.r ?? '0deg'}`}
        />
      ))}
    </div>

    <img class="logo" src="/assets/brand/logo-light-compact.svg" alt="" width="72" height="118" />

    <h1 class="names">
      <img src="/assets/brand/names-lettering-light.svg" alt="Daniela & Julien" width="380" height="261" />
    </h1>

    <nav class="picker" aria-label="Language / Langue / Sprache / Idioma">
      <ul>
        {pickerOptions.map((o) => (
          <li>
            <a href={pageUrl(o.lang)} lang={o.lang} hreflang={o.lang}>
              <span class="label">{o.label}</span>
              <span class="greeting">{o.greeting}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="date">{pickerDate}</p>
  </main>
</Base>

<style is:global>
  body { background: var(--ocean-blue); }
</style>

<style>
  .stage {
    --u: calc(100vw / 1512); /* 1 design px */
    position: relative; overflow: clip; isolation: isolate;
    min-height: 100svh; background: var(--bg); color: var(--fg);
    display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    padding: clamp(3rem, 14.3vw, 8rem) var(--page-gutter) clamp(2rem, 5vw, 4.5rem);
    gap: 3rem;
  }
  @media (max-width: 799px) { .stage { --u: calc(100vw / 640); } }

  .logo { position: absolute; top: clamp(1.25rem, 4.6vw, 2.4rem); left: clamp(1.25rem, 4.1vw, 3.9rem); width: clamp(2.75rem, 4.8vw, 4.5rem); height: auto; }
  .names img { width: clamp(15rem, 25vw, 23.75rem); height: auto; }

  .picker ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, auto); gap: 2rem 3rem; justify-content: center; }
  @media (min-width: 800px) { .picker ul { display: flex; gap: clamp(2rem, 6.5vw, 6rem); } }
  .picker a { display: grid; gap: .35rem; text-align: center; text-decoration: none; color: var(--fg); padding: .25rem .5rem; border-radius: .5rem; }
  .greeting { opacity: .5; transition: opacity .2s; }
  .picker a:hover .greeting, .picker a:focus-visible .greeting { opacity: 1; }
  .picker a:hover .label, .picker a:focus-visible .label { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .picker a:focus-visible { outline-color: var(--light-blue); }

  .date { font-style: italic; font-size: clamp(1.25rem, 1rem + .9vw, 2rem); opacity: .5; }

  /* Decorative blooms (15% opacity), positioned in "design pixels" so they scale with the viewport */
  .blooms { position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: .15; }
  .bloom {
    position: absolute; height: auto;
    width: calc(var(--w) * var(--u));
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    transform: translate(-50%, -50%) rotate(var(--r));
  }
  .bloom.flip { transform: translate(-50%, 50%) scaleX(-1) rotate(var(--r)); }
  .bloom.bottom { top: auto; bottom: calc((823 - var(--y)) * var(--u)); transform: translate(-50%, 50%) rotate(var(--r)); }
  .bloom.bottom.flip { transform: translate(-50%, 50%) scaleX(-1) rotate(var(--r)); }
</style>
